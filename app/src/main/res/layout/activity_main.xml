<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/tvTituloTest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📱 Test de Apps Móviles 📱"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:padding="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="#FF6200EE"
        android:elevation="4dp"
        android:textAllCaps="true"/>

    <Chronometer
        android:id="@+id/cronometro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:textColor="@color/design_default_color_primary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"/>

    <LinearLayout
        android:id="@+id/layoutPregunta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/cronometro"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/btnSiguiente"
        app:layout_constraintVertical_bias="0.2"
        android:layout_marginTop="16dp">

        <TextView
            android:id="@+id/tvPregunta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Texto de la pregunta aquí"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="24dp"
            android:textColor="?android:attr/textColorPrimary"/>

        <RadioGroup
            android:id="@+id/rgOpciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbOpcion1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Opción 1"
                android:textSize="18sp"
                android:layout_marginBottom="8dp"
                android:padding="12dp"
                android:background="@drawable/selector_radio_button"
                android:textColor="?android:attr/textColorSecondary"/>

            <RadioButton
                android:id="@+id/rbOpcion2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Opción 2"
                android:textSize="18sp"
                android:layout_marginBottom="8dp"
                android:padding="12dp"
                android:background="@drawable/selector_radio_button"
                android:textColor="?android:attr/textColorSecondary"/>

            <RadioButton
                android:id="@+id/rbOpcion3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Opción 3"
                android:textSize="18sp"
                android:layout_marginBottom="8dp"
                android:padding="12dp"
                android:background="@drawable/selector_radio_button"
                android:textColor="?android:attr/textColorSecondary"/>

            <RadioButton
                android:id="@+id/rbOpcion4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Opción 4"
                android:textSize="18sp"
                android:layout_marginBottom="16dp"
                android:padding="12dp"
                android:background="@drawable/selector_radio_button"
                android:textColor="?android:attr/textColorSecondary"/>
        </RadioGroup>
    </LinearLayout>

    <TextView
        android:id="@+id/tvFeedback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Feedback aparecerá aquí"
        android:textSize="18sp"
        android:textStyle="italic"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/layoutPregunta"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"/>

    <ImageView
        android:id="@+id/ivFeedbackGif"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:visibility="gone"
        tools:visibility="visible"
        tools:src="@drawable/gif_incorrecto"
        app:layout_constraintTop_toBottomOf="@id/tvFeedback"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"
        android:contentDescription="GIF de feedback"/>

    <Button
        android:id="@+id/btnSiguiente"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Siguiente Pregunta"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"/>

    <LinearLayout
        android:id="@+id/layoutResultados"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvResultadoTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¡Test Completado!"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tvResultadoDetalle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Puntuación: X%\nCorrectas: Y\nIncorrectas: Z\nTiempo: HH:MM:SS"
            android:textSize="20sp"
            android:gravity="center"
            android:lineSpacingExtra="8dp"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btnReiniciar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reiniciar Test"
            android:textSize="18sp"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
